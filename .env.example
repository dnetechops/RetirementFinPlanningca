# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://fimoksha:change-me@localhost:5432/fimoksha
PORT=8080
# Address people use to open the app (used in email links; https turns on secure cookies)
PUBLIC_URL=http://localhost:8080
# false = only admins can create accounts
ALLOW_SIGNUP=true

# Optional email (sign-up confirmation, password reset). Leave SMTP_HOST empty for no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FiMoksha <no-reply@example.ca>
